# ==============================================================================
# UC Bot Konfiguratsiyasi (.env)
# ==============================================================================

# 1. BOT & ADMIN MA'LUMOTLARI
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_ID=6401724005
SUPER_ADMINS=6401724005
BOT_ID=1
BOT_USERNAME=MyUcBot

# 2. POSTGRESQL DATABASE MA'LUMOTLARI (Multi-tenancy Schema Isolation)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=builder_db
DB_SCHEMA=uc_bot_1

# 3. REDIS MA'LUMOTLARI
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 4. WEBHOOK MA'LUMOTLARI (Bo'sh bo'lsa avtomatik ravishda Polling rejimida ishlaydi)
WEBHOOK_URL=
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook/bot/1
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=10001
